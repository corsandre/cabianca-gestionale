# ============================================
# Fattoria Ca Bianca - Gestionale
# Configurazione ambiente
# ============================================

# Chiave segreta per sessioni e JWT (generata automaticamente da setup.sh)
SECRET_KEY=change-me-to-a-random-string

# Database
DATABASE_URL=sqlite:///data/gestionale.db

# Utente amministratore (creato al primo avvio)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_DISPLAY_NAME=Amministratore

# Telegram Bot (per notifiche)
TELEGRAM_BOT_TOKEN=
# Chat o gruppo delle notifiche finanza (scadenze, banca, cassa, fatture SDI)
TELEGRAM_CHAT_ID=
# Gruppo delle notifiche di sistema (backup); vuoto = in TELEGRAM_CHAT_ID
TELEGRAM_SISTEMA_CHAT_ID=
# ID del gruppo aziendale (numero negativo): il bot risponde solo lì e, in privato, solo ai suoi membri.
# Vuoto = nessun controllo (il bot scrive nel log l'ID dei gruppi in cui riceve messaggi)
TELEGRAM_GROUP_ID=

# 4CloudOffice - Registratore di cassa
CLOUD_OFFICE_URL=https://www.4cloudoffice.com/v2/
CLOUD_OFFICE_USER=
CLOUD_OFFICE_PASSWORD=

# SMTP - Backup via email
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# IMAP - Recupero fatture SDI via email
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SEARCH_FROM=

# App
APP_PORT=8080
APP_HOST=0.0.0.0
APP_DEBUG=false

# Cookie solo su HTTPS (default 1). Metti 0 solo se l'app è usata in http, es. in LAN senza proxy
COOKIE_SECURE=1
